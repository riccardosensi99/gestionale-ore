# Database
POSTGRES_USER=gestionale
POSTGRES_PASSWORD=change-this-to-a-strong-password
POSTGRES_DB=gestionale

# Backend
NODE_ENV=production
JWT_SECRET=change-this-to-a-long-random-string
FRONTEND_URL=https://<hostname>.<tailnet-name>.ts.net

# Google OAuth (il redirect URI deve corrispondere esattamente a quello
# registrato su https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://<hostname>.<tailnet-name>.ts.net/api/auth/google/callback

# Email che diventano admin al primo login (separate da virgola)
ADMIN_EMAILS=riccardosensi57@gmail.com

# Whitelist di chi può accedere (separate da virgola, o interi domini @azienda.it).
# Vuota qui e nel backoffice = accedono solo gli ADMIN_EMAILS.
ALLOWED_EMAILS=

# MAI true in produzione (comunque ignorato quando NODE_ENV=production)
DEV_LOGIN=false
