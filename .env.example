# Database
POSTGRES_USER=gestionale
POSTGRES_PASSWORD=gestionale
POSTGRES_DB=gestionale
DB_PORT=5432

# Ports
BACKEND_PORT=4000
FRONTEND_PORT=5173

# Backend
NODE_ENV=development
JWT_SECRET=change-this-to-a-long-random-string
FRONTEND_URL=http://localhost:5173

# Google OAuth (crea le credenziali su https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback

# Email che diventano admin al primo login (separate da virgola)
ADMIN_EMAILS=riccardosensi57@gmail.com

# Whitelist di chi può accedere (separate da virgola). Accetta email singole
# oppure interi domini nella forma @azienda.it. Se vuota (qui e nel
# backoffice), accedono solo gli ADMIN_EMAILS.
ALLOWED_EMAILS=

# Login di sviluppo: bypassa Google per provare l'app in locale.
# MAI attivare in produzione (ignorato se NODE_ENV=production).
DEV_LOGIN=true

# Frontend
VITE_API_URL=http://localhost:4000
